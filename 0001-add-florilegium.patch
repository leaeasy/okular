+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_FLORAL_GEOMETRY_H
+#define OKULAR_FLORAL_GEOMETRY_H
+
+#include "species.h"
+#include <QPainterPath>
+#include <QPointF>
+#include <QtMath>
+#include <algorithm>
+#include <cmath>
+
+namespace Floral
+{
+enum class OrganKind { Leaf, Flower, Bud };
+struct Organ {
+    OrganKind kind;
+    QPointF position;
+    qreal angle;
+    qreal size;
+    qreal senescence = 0;
+    int stem = -1;        // Owning stem in Garden::stems.
+    int speciesIndex = 0; // Index within the vertical community, or zero for a single species.
+};
+struct Stem {
+    QPainterPath path;
+    qreal baseWidth;
+    qreal tipWidth;
+    int parent; // -1 for a primary shoot; otherwise an index into Garden::stems.
+    int depth;
+    qreal parentPosition;
+    qreal senescence = 0;
+    int speciesIndex = 0;
+};
+struct Garden {
+    QList<Stem> stems;
+    QList<Organ> organs;
+};
+inline qreal separation(QPointF a, QPointF b)
+{
+    const QPointF delta = a - b;
+    return std::sqrt(QPointF::dotProduct(delta, delta));
+}
+inline QPointF direction(QPointF vector)
+{
+    const qreal length = separation(vector, {});
+    return length > 0.00001 ? vector / length : QPointF(0, -1);
+}
+inline QPointF endDirection(const QPainterPath &path)
+{
+    const QPointF end = path.currentPosition();
+    // The final Bezier control point defines the exact outgoing derivative.
+    // Fall back through coincident controls for a degenerate endpoint.
+    for (int i = path.elementCount() - 2; i >= 0; --i) {
+        const auto control = path.elementAt(i);
+        const QPointF delta = end - QPointF(control.x, control.y);
+        if (separation(delta, {}) > 0.00001) {
+            return direction(delta);
+        }
+    }
+    return QPointF(0, -1);
+}
+
+inline QPointF tangent(const QPainterPath &path, qreal t)
+{
+    return direction(path.pointAtPercent(qMin(qreal(1), t + 0.001)) - path.pointAtPercent(qMax(qreal(0), t - 0.001)));
+}
+inline QPointF limitDirection(QPointF wanted, QPointF axis, qreal maximumAngle)
+{
+    axis = direction(axis);
+    wanted = direction(wanted);
+    const qreal angle = qBound(-maximumAngle, std::atan2(axis.x() * wanted.y() - axis.y() * wanted.x(), QPointF::dotProduct(axis, wanted)), maximumAngle);
+    return QPointF(axis.x() * std::cos(angle) - axis.y() * std::sin(angle), axis.x() * std::sin(angle) + axis.y() * std::cos(angle));
+}
+
+inline qreal degrees(QPointF axis)
+{
+    return std::atan2(axis.x(), -axis.y()) * 180 / 3.14159265358979323846;
+}
+
+// Length envelope follows attachment order along the stem, including curled tips.
+inline qreal lateralLengthLimit(qreal growthPosition, int parentDepth)
+{
+    const qreal remaining = 1 - qBound(qreal(0), growthPosition, qreal(1));
+    return (22 + 95 * std::pow(remaining, 0.9)) * std::pow(0.8, parentDepth);
+}
+
+inline int primaryCount(quint32 seed)
+{
+    QRandomGenerator random(seed ^ 0x35d7e8a1U);
+    return 1 + random.bounded(3);
+}
+struct Shoot {
+    Stem stem;
+    qreal flower;
+};
+// Isolated stream: attachment queries can reproduce just a primary curve,
+// without generating the leaf field or consuming the composition's RNG.
+inline Shoot primaryShoot(quint32 seed, const Species &species, qreal height, int shoot, int count, bool footer = false, qreal readingProgress = 1)
+{
+    QRandomGenerator random(seed ^ (quint32(shoot + 1) * 0x9e3779b9U));
+    auto unit = [&] { return random.generateDouble(); };
+    const qreal fraction = shoot == 0 ? 1 : shoot == 1 ? 0.66 + unit() * 0.06 : 0.38 + unit() * 0.07;
+    const qreal flower = qMin(height * 0.16, (shoot == 0 ? 25 + unit() * 5 : shoot == 1 ? 15 + unit() * 5 : 9 + unit() * 5));
+    const qreal length = footer ? height : qMax(qreal(8), height * fraction - flower - 5);
+    const qreal phase = unit() * 6.283185307179586;
+    const qreal spread = shoot == 0 ? 0 : shoot == 1 ? -20 : 21;
+    auto point = [&](qreal d) {
+        if (footer) {
+            // Begin below the visible page, then rise in one broad, smooth bend.
+            // Low-frequency sway avoids a kink at a forced visible junction.
+            const qreal t = qBound(qreal(0), d / 150, qreal(1));
+            const qreal ease = t * t * (3 - 2 * t);
+            const qreal sway = species.stemSway * 0.25 * std::sin(d / 190 + phase) + 1.5 * std::sin(d / 95 + phase);
+            const qreal maturity = qBound(qreal(0), (height - d) / height, qreal(1));
+            // Keep the basal stretch calm, then allow a broad, rising sweep.
+            const qreal stretch = qBound(qreal(0), (d / height - 0.2) / 0.8, qreal(1));
+            const qreal rise = stretch * stretch * (3 - 2 * stretch);
+            const qreal progress = qBound(qreal(0), readingProgress, qreal(1));
+            const qreal tipZone = qBound(qreal(0), (d / height - 0.85) / 0.15, qreal(1));
+            const qreal boundedLift = 35 + 30 * tipZone * tipZone * (3 - 2 * tipZone);
+            const qreal lift = (progress > 0.3 ? boundedLift : 100 + 30 * std::sin(phase)) * rise;
+            // A broad middle dip interrupts the upward sweep without changing
+            // the basal entry or terminal height. Zero endpoint slopes keep it calm.
+            const qreal dipPosition = qBound(qreal(0), (d / height - 0.28) / 0.48, qreal(1));
+            const qreal dipWave = std::sin(dipPosition * 3.14159265358979323846);
+            const qreal dip = (18 + 3 * std::sin(phase)) * dipWave * dipWave;
+            const qreal visibleAxis = 90 - 45 * maturity + sway * maturity - lift + dip;
+            QPointF position(120 * (1 - ease) + visibleAxis * ease, height - d);
+            const qreal curlLength = qMin(height * (0.34 + 0.04 * std::sin(phase)), qreal(150));
+            const qreal curlAngle = std::pow(1 - qBound(qreal(0), readingProgress, qreal(1)), 1.15) * (1.12 + 0.08 * std::sin(phase)) * 3.14159265358979323846;
+            if (curlAngle > 0.0001 && d > height - curlLength) {
+                const qreal s = qMax(qreal(0), (d - height + curlLength) / curlLength);
+                // Integrate a gradually turning tangent instead of attaching a
+                // constant-radius circle. Curvature starts at zero and tightens
+                // towards the growing tip, with modest seed-dependent variation.
+                QPointF displacement;
+                constexpr int steps = 24;
+                for (int j = 0; j < steps; ++j) {
+                    const qreal u = s * (j + 0.5) / steps;
+                    const qreal angle = curlAngle * u * u;
+                    displacement += QPointF(-std::sin(angle), 1 - std::cos(angle));
+                }
+                position += displacement * (curlLength * s / steps);
+            }
+            if (progress > 0.3) {
+                // A soft bound bends the axis back into its height envelope;
+                // it does not clip or constrain attached organs and branches.
+                const qreal minimumX = 2 - 8 * tipZone * tipZone * (3 - 2 * tipZone);
+                const qreal delta = position.x() - minimumX;
+                position.setX(minimumX + (delta + std::sqrt(delta * delta + 16)) * 0.5);
+            }
+            return position;
+        }
+        const qreal fade = 1 - std::exp(-d / 55);
+        const qreal sway = species.stemSway * 0.65 * std::sin(d / (80 + shoot * 17) + phase) + 4 * std::sin(d / 37 + phase);
+        return QPointF(45 + fade * (spread + sway), height - d);
+    };
+    auto slope = [&](qreal d) { return (point(d + 0.1) - point(d - 0.1)) / 0.2; };
+    QPainterPath path(point(0));
+    const int segments = qMax(1, qCeil(length / 24));
+    for (int i = 0; i < segments; ++i) {
+        const qreal start = length * i / segments;
+        const qreal end = length * (i + 1) / segments;
+        const qreal handle = (end - start) / 3;
+        path.cubicTo(point(start) + slope(start) * handle, point(end) - slope(end) * handle, point(end));
+    }
+    // Fewer primary shoots carry more visual weight. The footer is a finer
+    // lateral, never another fan of independent primary shoots.
+    const qreal base = footer ? 0.65 : (2.6 - count * 0.35) * (shoot == 0 ? 1 : 0.8);
+    return {{path, base, footer ? 0 : 0.35, -1, 0, 0}, flower};
+}
+struct FooterAttachment {
+    int parent;
+    qreal t;
+    QPointF position;
+    QPointF axis;
+};
+inline FooterAttachment footerAttachment(quint32 seed, const Species &species, qreal height, qreal clearance, const VerticalCommunity *community = nullptr)
+{
+    const int count = community ? int(community->size()) : primaryCount(seed);
+    QRandomGenerator random(seed ^ 0x1c2d379bU);
+    const int parent = random.bounded(count);
+    const Stem stem = primaryShoot(seed, community ? (*community)[parent] : species, height, parent, count).stem;
+    const qreal length = height - stem.path.currentPosition().y();
+    const qreal t = qMin(qreal(0.8), clearance / length);
+    return {parent, t, stem.path.pointAtPercent(t), tangent(stem.path, t)};
+}
+
+// The entire footer tapers from its basal origin to the growing tip. There
+// is no full-sized plateau followed by a separate terminal shrinking zone.
+inline qreal tipMaturity(qreal distanceToTip, qreal height)
+{
+    return height > 0 ? qBound(qreal(0), distanceToTip / height, qreal(1)) : 0;
+}
+
+// Sparse, smooth pockets of extra space. The nominal width stays 100; only
+// selected local stretches can grow into the page, never the whole border.
+struct GrowthEnvelope {
+    struct Bulge {
+        qreal center;
+        qreal halfLength;
+        qreal reach;
+    };
+    QList<Bulge> bulges;
+    bool footer;
+    qreal height;
+    qreal extra(qreal y) const
+    {
+        qreal amount = 0;
+        for (const auto &bulge : bulges) {
+            const qreal t = std::abs(y - bulge.center) / bulge.halfLength;
+            if (t < 1) {
+                amount = qMax(amount, bulge.reach * (1 + std::cos(t * 3.14159265358979323846)) / 2);
+            }
+        }
+        return amount;
+    }
+    qreal left(qreal y) const
+    {
+        const qreal travel = 1 - tipMaturity(y, height);
+        return footer ? 2 - 130 * travel * travel * (3 - 2 * travel) - extra(y) : 2;
+    }
+    qreal right(qreal y) const
+    {
+        return footer ? 90 + 8 * tipMaturity(y, height) : 98 + extra(y);
+    }
+};
+inline GrowthEnvelope growthEnvelope(quint32 seed, qreal height, bool footer, bool enabled = true)
+{
+    GrowthEnvelope envelope {{}, footer, height};
+    QRandomGenerator random(seed ^ 0x86de17a3U);
+    if (enabled && height >= 100 && random.generateDouble() < 0.7) {
+        const int count = qBound(1, int(height / 450), 3);
+        for (int i = 0; i < count; ++i) {
+            envelope.bulges.append({height * (i + 0.3 + random.generateDouble() * 0.4) / count, qMin(height * 0.16, 55 + random.generateDouble() * 45), 32 + random.generateDouble() * 16});
+        }
+    }
+    return envelope;
+}
+
+}
+#endif
diff --git a/plugins/floral/growth.h b/plugins/floral/growth.h
new file mode 100644
index 000000000..0dce961f9
--- /dev/null
+++ b/plugins/floral/growth.h
@@ -0,0 +1,264 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_FLORAL_GROWTH_H
+#define OKULAR_FLORAL_GROWTH_H
+
+#include "lateral.h"
+
+namespace Floral
+{
+// A stable rank lets reproductive sites change stage progressively while
+// retaining the same stems, attachment points and species on repeated paints.
+inline void applySeason(Garden &garden, quint32 seed, qreal progress)
+{
+    QRandomGenerator stages(seed ^ 0x6e7329b5U);
+    const qreal buds = qBound(qreal(0), (progress - 0.2) / 0.2, qreal(1));
+    const qreal bloom = qBound(qreal(0), (progress - 0.4) / 0.6, qreal(1));
+    for (Organ &organ : garden.organs) {
+        const qreal rank = stages.generateDouble();
+        if (organ.kind == OrganKind::Leaf) {
+            continue;
+        }
+        const bool wasFlower = organ.kind == OrganKind::Flower;
+        if (progress <= 0.2 || (progress <= 0.4 && rank >= buds)) {
+            organ.kind = OrganKind::Leaf;
+            organ.size *= wasFlower ? 0.7 : 1.4;
+        } else if (wasFlower && rank < bloom) {
+            organ.kind = OrganKind::Flower;
+            organ.size *= 0.7 + 0.3 * bloom;
+        } else {
+            organ.kind = OrganKind::Bud;
+            organ.size *= wasFlower ? 0.7 : 1;
+        }
+    }
+}
+
+inline void applySenescence(Garden &garden, quint32 seed, qreal progress, int pages, bool footer)
+{
+    if (pages <= 10 || progress <= 0.8 || footer) {
+        return;
+    }
+    const qreal age = qBound(qreal(0), (progress - 0.8) / 0.2, qreal(1));
+    QRandomGenerator aging(seed ^ 0x4d3cbe71U);
+    // Stable ranks expose only part of the plant to aging, increasingly after
+    // 80%. Repainting cannot resample affected sites or move attachment points.
+    for (Stem &stem : garden.stems) {
+        const qreal rank = aging.generateDouble();
+        stem.senescence = qMax(qreal(0), age - rank / 0.65);
+    }
+    for (Organ &organ : garden.organs) {
+        const qreal rank = aging.generateDouble();
+        organ.senescence = qMax(qreal(0), age - rank / 0.6);
+        if (organ.senescence > 0) {
+            organ.angle += (organ.angle < 0 ? -1 : 1) * organ.senescence * 55;
+        }
+    }
+}
+
+// Geometry is independent of paint style/texture. Its discs describe available
+// space, not a fixed menu of organ sizes: large holes are filled before small.
+inline Garden growGarden(quint32 seed,
+                         int density,
+                         const Species &species,
+                         qreal height,
+                         bool footer = false,
+                         bool overflow = true,
+                         qreal readingProgress = 1,
+                         int documentPages = 0,
+                         qreal minimumLeafSize = 0,
+                         qreal flowerRadius = 8,
+                         const VerticalCommunity *community = nullptr)
+{
+    Garden garden;
+    if (height < 32) {
+        return garden;
+    }
+    if (footer) {
+        return growReadingLateral(seed, density, species, height, readingProgress, minimumLeafSize, flowerRadius);
+    }
+    readingProgress = qBound(qreal(0), readingProgress, qreal(1));
+    const auto envelope = growthEnvelope(seed, height, false, overflow);
+    QRandomGenerator random(seed);
+    auto unit = [&] { return random.generateDouble(); };
+    struct Disc {
+        QPointF center;
+        qreal radius;
+    };
+    struct Sample {
+        QPointF position;
+        QPointF axis;
+        qreal width;
+        int stem;
+        int depth;
+        qreal t;
+    };
+    QList<Disc> occupied;
+    QList<Sample> samples;
+    auto reserve = [&](QPointF center, qreal radius) { occupied.append({center, radius * 0.85}); };
+    auto room = [&](QPointF center, qreal radius) {
+        if (center.x() - radius < envelope.left(center.y()) || center.x() + radius > envelope.right(center.y()) || center.y() - radius < 2 || center.y() + radius > height - 2) {
+            return false;
+        }
+        for (const Disc &disc : occupied) {
+            if (std::abs(center.y() - disc.center.y()) < radius + disc.radius && separation(center, disc.center) < radius + disc.radius) {
+                return false;
+            }
+        }
+        return true;
+    };
+    auto addSamples = [&](int index, int count) {
+        const Stem &stem = garden.stems[index];
+        for (int i = 0; i <= count; ++i) {
+            const qreal t = i / qreal(count);
+            samples.append({stem.path.pointAtPercent(t), tangent(stem.path, t), stem.baseWidth * (1 - t) + stem.tipWidth * t, index, stem.depth, t});
+        }
+    };
+    // One primary per selected species; all share the same occupancy field.
+    const int count = community ? int(community->size()) : primaryCount(seed);
+    for (int shoot = 0; shoot < count; ++shoot) {
+        const auto &shootSpecies = community ? (*community)[shoot] : species;
+        const int speciesIndex = community ? shoot : 0;
+        Shoot primary = primaryShoot(seed, shootSpecies, height, shoot, count);
+        primary.stem.speciesIndex = speciesIndex;
+        const QPainterPath &path = primary.stem.path;
+        garden.stems.append(primary.stem);
+        const qreal length = height - path.currentPosition().y();
+        addSamples(shoot, qMax(2, qCeil(length / 8)));
+        const QPointF tip = path.currentPosition();
+        const qreal radius = qMin(primary.flower, qMin(tip.x() - 3, 97 - tip.x()));
+        if (room(tip, radius * 0.8)) {
+            garden.organs.append({OrganKind::Flower, tip, degrees(tangent(path, 1)) + (unit() - 0.5) * 18, radius, 0, shoot, speciesIndex});
+            reserve(tip, radius);
+        }
+    }
+    for (int shoot = 0; shoot < count; ++shoot) {
+        const int speciesIndex = garden.stems[shoot].speciesIndex;
+        const auto &shootSpecies = community ? (*community)[speciesIndex] : species;
+        const QPainterPath &path = garden.stems[shoot].path;
+        const qreal length = height - path.currentPosition().y();
+        const qreal gap = shootSpecies.nodeGap * (1.9 - qBound(0, density, 100) / 150.0);
+        int node = 0;
+        for (qreal d = 28 + unit() * 12; d < length - 26; d += gap * (0.65 + unit() * 0.8), ++node) {
+            // Leave breathing room between groups rather than a regular ladder.
+            if (unit() < 0.15) {
+                continue;
+            }
+            const qreal t = d / length;
+            const QPointF origin = path.pointAtPercent(t);
+            const qreal stemAngle = degrees(tangent(path, t));
+            const int leaves = shootSpecies.arrangement == Arrangement::Opposite ? 2 : shootSpecies.arrangement == Arrangement::Whorled ? 3 : 1;
+            for (int i = 0; i < leaves; ++i) {
+                const int side = leaves == 1 ? (node % 2 ? -1 : 1) : (i % 2 ? -1 : 1);
+                const qreal angle = stemAngle + side * (shootSpecies.leafAngle + (unit() - 0.5) * 22);
+                const qreal size = (10 + 25 * std::pow(unit(), 0.7)) * (0.45 + 0.55 * std::sin(3.14159265358979323846 * (0.1 + 0.85 * t))) * (shoot == 0 ? 1 : 0.8);
+                const qreal radians = angle * 3.14159265358979323846 / 180;
+                const QPointF axis(std::sin(radians), -std::cos(radians));
+                const QPointF center = origin + axis * size * 0.5;
+                const qreal radius = size * (shootSpecies.leaflets > 1 ? 0.4 : qMax(qreal(0.25), shootSpecies.leafWidth));
+                if (size >= 0.6 && room(center, radius)) {
+                    garden.organs.append({OrganKind::Leaf, origin, angle, size, 0, shoot, speciesIndex});
+                    reserve(center, radius);
+                }
+            }
+        }
+    }
+    std::sort(occupied.begin(), occupied.end(), [](const Disc &a, const Disc &b) { return a.center.y() < b.center.y(); });
+    std::sort(samples.begin(), samples.end(), [](const Sample &a, const Sample &b) { return a.position.y() < b.position.y(); });
+    qreal maxRadius = 0;
+    for (const Disc &disc : occupied) {
+        maxRadius = qMax(maxRadius, disc.radius);
+    }
+    struct Cell {
+        QPointF center;
+        qreal free;
+        qreal nearest;
+        Sample source;
+    };
+    QList<Cell> field;
+    for (int y = 10; y < height - 8; y += 8) {
+        for (int x = 8; x <= (overflow ? 136 : 96); x += 8) {
+            Cell cell {QPointF(x, y), qMin(qMin(x - envelope.left(y), envelope.right(y) - x), qMin(qreal(y - 2), height - y - 2)), 55, {}};
+            if (cell.free <= 0) {
+                continue;
+            }
+            const qreal reach = cell.free + maxRadius;
+            auto disc = std::lower_bound(occupied.cbegin(), occupied.cend(), y - reach, [](const Disc &a, qreal low) { return a.center.y() < low; });
+            for (; disc != occupied.cend() && disc->center.y() < y + reach; ++disc) {
+                cell.free = qMin(cell.free, separation(cell.center, disc->center) - disc->radius);
+            }
+            auto sample = std::lower_bound(samples.cbegin(), samples.cend(), y - 55, [](const Sample &a, qreal low) { return a.position.y() < low; });
+            for (; sample != samples.cend() && sample->position.y() <= y + 55; ++sample) {
+                const qreal distance = separation(cell.center, sample->position);
+                if (distance < cell.nearest) {
+                    cell.nearest = distance;
+                    cell.source = *sample;
+                }
+            }
+            field.append(cell);
+        }
+    }
+    const int attempts = qCeil((12 + qBound(0, density, 100) * 65 / 100) * height / 800);
+    for (int step = 0; step < attempts; ++step) {
+        int chosen = -1;
+        qreal best = 0;
+        for (int i = 0; i < field.size(); ++i) {
+            const Cell &cell = field[i];
+            if (cell.free >= 3.6 && cell.nearest < 55 && cell.source.depth < 3) {
+                const qreal score = cell.free * (0.92 + unit() * 0.16);
+                if (score > best) {
+                    best = score;
+                    chosen = i;
+                }
+            }
+        }
+        if (chosen < 0) {
+            break;
+        }
+        const Cell cell = field[chosen];
+        const qreal radius = cell.free * (0.82 + unit() * 0.08);
+        if (radius < 0.5) {
+            field[chosen].free = 0;
+            continue;
+        }
+        const int speciesIndex = garden.stems[cell.source.stem].speciesIndex;
+        const auto &shootSpecies = community ? (*community)[speciesIndex] : species;
+        const bool flower = radius > 12 && (radius > 22 || unit() < shootSpecies.flowerWeight);
+        const OrganKind kind = flower ? OrganKind::Flower : radius > 5.5 ? OrganKind::Leaf : OrganKind::Bud;
+        const qreal size = kind == OrganKind::Leaf ? radius * 1.65 : radius;
+        QPointF axis = direction(QPointF((cell.center.x() - cell.source.position.x()) * 0.7, -qMax(qreal(8), std::abs(cell.center.y() - cell.source.position.y()) * 0.4)));
+        const QPointF anchor = cell.center - (kind == OrganKind::Leaf ? axis * size * 0.45 : QPointF());
+        const qreal distance = separation(anchor, cell.source.position);
+        const qreal handle = qBound(qreal(4), distance * 0.45, qreal(28));
+        QPainterPath branch(cell.source.position);
+        branch.cubicTo(cell.source.position + cell.source.axis * handle, anchor - axis * handle, anchor);
+        const qreal base = cell.source.width * 0.75;
+        const int index = garden.stems.size();
+        garden.stems.append({branch, base, qMin(base * 0.45, qreal(0.25)), cell.source.stem, cell.source.depth + 1, cell.source.t, 0, speciesIndex});
+        garden.organs.append({kind, anchor, degrees(axis), size, 0, index, speciesIndex});
+        QList<Sample> newSamples;
+        if (cell.source.depth < 2) {
+            for (int i = 1; i <= 6; ++i) {
+                const qreal t = i / 6.0;
+                newSamples.append({branch.pointAtPercent(t), tangent(branch, t), base * (1 - t) + qMin(base * 0.45, qreal(0.25)) * t, index, cell.source.depth + 1, t});
+            }
+        }
+        for (Cell &candidate : field) {
+            if (std::abs(candidate.center.y() - cell.center.y()) < candidate.free + radius) {
+                candidate.free = qMin(candidate.free, separation(candidate.center, cell.center) - radius * 0.85);
+            }
+            for (const Sample &sample : newSamples) {
+                if (std::abs(candidate.center.y() - sample.position.y()) < candidate.nearest) {
+                    const qreal distance = separation(candidate.center, sample.position);
+                    if (distance < candidate.nearest) {
+                        candidate.nearest = distance;
+                        candidate.source = sample;
+                    }
+                }
+            }
+        }
+    }
+    applySeason(garden, seed, readingProgress);
+    applySenescence(garden, seed, readingProgress, documentPages, false);
+    return garden;
+}
+}
+#endif
diff --git a/plugins/floral/lateral.h b/plugins/floral/lateral.h
new file mode 100644
index 000000000..703079b6a
--- /dev/null
+++ b/plugins/floral/lateral.h
@@ -0,0 +1,230 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_FLORAL_LATERAL_H
+#define OKULAR_FLORAL_LATERAL_H
+
+#include "geometry.h"
+
+namespace Floral
+{
+inline qreal terminalFlowerRadius(qreal progress)
+{
+    return 1.5 + 6 * qBound(qreal(0), progress, qreal(1));
+}
+
+// Weighted priority gives the main axis and older shoots more foliage. Any
+// eligible uncovered stem receives a fallback leaf within its capacity.
+inline QList<int> allocateLateralLeaves(int budget, const QList<qreal> &weights, const QList<int> &capacities = {})
+{
+    QList<int> counts(weights.size(), 0);
+    for (int leaf = 0; leaf < budget; ++leaf) {
+        int chosen = -1;
+        qreal priority = -1;
+        for (int stem = 0; stem < weights.size(); ++stem) {
+            if (!capacities.isEmpty() && counts[stem] >= capacities[stem]) {
+                continue;
+            }
+            const qreal score = weights[stem] / (counts[stem] + 1);
+            if (score > priority) {
+                priority = score;
+                chosen = stem;
+            }
+        }
+        if (chosen < 0) {
+            break;
+        }
+        ++counts[chosen];
+    }
+    for (int stem = 0; stem < counts.size(); ++stem) {
+        if (capacities.isEmpty() || capacities[stem] > 0) {
+            counts[stem] = qMax(1, counts[stem]);
+        }
+    }
+    return counts;
+}
+
+// Progress budgets are separate from spatial capacity: a full stem cannot
+// receive more foliage merely because the document has a larger leaf budget.
+struct LateralPlan {
+    int branches;
+    int axisFlowers;
+    int leafBudget;
+    std::array<int, 10> flowerCounts {};
+    QList<qreal> leafWeights;
+};
+
+inline LateralPlan lateralPlan(qreal progress)
+{
+    LateralPlan plan;
+    plan.branches = qMin(10, int(std::floor(progress * 10 + 1e-9)));
+    // Allocate each milestone's flower budget by priority: main axis first,
+    // then older branches, at most three per stem. The newest gets none.
+    plan.axisFlowers = qMin(3, plan.branches);
+    int remainingFlowers = plan.branches - plan.axisFlowers;
+    for (int node = 0; node < plan.branches - 1 && remainingFlowers > 0; ++node) {
+        const qreal age = qBound(qreal(0), (progress - (node + 1) / 10.0) / 0.35, qreal(1));
+        const int capacity = 1 + int(std::floor(age * 2 + 1e-9));
+        plan.flowerCounts[node] = qMin(capacity, remainingFlowers);
+        remainingFlowers -= plan.flowerCounts[node];
+    }
+    plan.leafBudget = int(std::floor(progress * 100 + 1e-9));
+    plan.leafWeights = {1.5};
+    for (int node = 0; node < plan.branches; ++node) {
+        const qreal age = qBound(qreal(0), (progress - (node + 1) / 10.0) / 0.35, qreal(1));
+        plan.leafWeights.append((0.2 + 0.8 * age) * (1 - 0.5 * node / (plan.branches + 1)));
+    }
+    return plan;
+}
+
+struct LateralBranchStats {
+    qreal age;
+    qreal t;
+    qreal tipLeaf;
+    qreal basalLeaf;
+};
+
+// Each ten-percent milestone adds exactly one branch. Independent per-node
+// random streams preserve its traits as existing branches continue to mature.
+inline Garden growReadingLateral(quint32 seed, int /*density*/, const Species &species, qreal height, qreal progress, qreal minimumLeafSize, qreal flowerRadius = 8)
+{
+    Garden garden;
+    progress = qBound(qreal(0), progress, qreal(1));
+    if (progress < 0.1) {
+        return garden;
+    }
+    const qreal leafFloor = qMax(minimumLeafSize, 2 + 6 * progress);
+    const Stem primary = primaryShoot(seed, species, height, 0, 1, true, progress).stem;
+    garden.stems.append(primary);
+    garden.organs.append({OrganKind::Leaf, primary.path.currentPosition(), degrees(endDirection(primary.path)), leafFloor, 0, 0});
+    const auto plan = lateralPlan(progress);
+    const int branches = plan.branches;
+    const auto &flowerCounts = plan.flowerCounts;
+    const qreal axisLength = primary.path.length();
+    QList<qreal> branchDistances;
+    QList<qreal> branchLeafSizes;
+    QList<LateralBranchStats> branchStats;
+    QList<int> leafCapacities {1};
+    auto nodePosition = [&](int node) {
+        // Include one virtual, not-yet-developed node beyond the last branch.
+        // Its interval continues the same exponential spacing progression.
+        const qreal fraction = (node + 0.5) / (10 * qMax(qreal(0.1), progress));
+        constexpr qreal spacingTaper = 2.4;
+        return 0.12 + 0.76 * -std::expm1(-spacingTaper * fraction) / -std::expm1(-spacingTaper);
+    };
+    // Phase 1: construct branches and measure their spatial leaf capacities.
+    const qreal terminalPosition = nodePosition(branches);
+    for (int node = 0; node < branches; ++node) {
+        QRandomGenerator traits(seed ^ (quint32(node + 1) * 0x5bd1e995U));
+        auto unit = [&] { return traits.generateDouble(); };
+        const qreal birth = (node + 1) / 10.0;
+        const qreal age = qBound(qreal(0), (progress - birth) / 0.35, qreal(1));
+        // The axis ends at the virtual next node, leaving only its expected
+        // interval after the last developed branch instead of a fixed bare tail.
+        const qreal distance = axisLength * nodePosition(node) / terminalPosition;
+        const qreal t = primary.path.percentAtLength(distance);
+        branchDistances.append(distance);
+        const QPointF origin = primary.path.pointAtPercent(t);
+        const QPointF parentAxis = tangent(primary.path, t);
+        const qreal angle = qDegreesToRadians(32 + unit() * 32) * (node % 4 == 2 ? 1 : -1);
+        const QPointF chord(parentAxis.x() * std::cos(angle) - parentAxis.y() * std::sin(angle), parentAxis.x() * std::sin(angle) + parentAxis.y() * std::cos(angle));
+        const qreal length = lateralLengthLimit(t, 0) * 0.96 * (0.35 + 0.65 * age) * (0.7 + 0.3 * progress);
+        const QPointF end = origin + chord * length;
+        const qreal bend = qDegreesToRadians((unit() - 0.5) * 18);
+        const QPointF arrival(chord.x() * std::cos(bend) - chord.y() * std::sin(bend), chord.x() * std::sin(bend) + chord.y() * std::cos(bend));
+        QPainterPath branch(origin);
+        branch.cubicTo(origin + limitDirection(parentAxis, chord, qDegreesToRadians(qreal(20))) * length / 3, end - arrival * length / 3, end);
+        const qreal width = primary.baseWidth * (1 - t) * 0.75;
+        garden.stems.append({branch, width, width * 0.35, 0, 1, t});
+        const qreal tipLeaf = leafFloor + 5 * age * (1 - t);
+        const qreal basalLeaf = 2 * (leafFloor + (5 + 12 * age) * (1 - t) * (1 - 0.55 * 0.28));
+        branchStats.append({age, t, tipLeaf, basalLeaf});
+        const int flowers = flowerCounts[node];
+        const qreal spacing = qMax(qreal(6), basalLeaf * 0.4);
+        const int spatialCapacity = qMax(1, 1 + int(branch.length() * (flowers > 0 ? 0.6 : 0.84) / spacing));
+        leafCapacities.append(flowers >= 3 ? 0 : flowers == 2 ? qMin(2, spatialCapacity) : spatialCapacity);
+    }
+    qreal largestLeaf = leafFloor;
+    for (int node = 0; node < branches; ++node) {
+        if (leafCapacities[node + 1] > 0) {
+            largestLeaf = qMax(largestLeaf, branchStats[node].basalLeaf);
+        }
+    }
+    leafCapacities[0] = 1 + int(axisLength * 0.84 / qMax(qreal(6), largestLeaf * 0.4));
+    // Phase 2: distribute foliage only after every stem capacity is known.
+    const QList<int> leafCounts = allocateLateralLeaves(plan.leafBudget, plan.leafWeights, leafCapacities);
+    for (int node = 0; node < branches; ++node) {
+        const int index = node + 1;
+        const auto &branch = garden.stems[index].path;
+        const auto &stats = branchStats[node];
+        const qreal age = stats.age;
+        const qreal t = stats.t;
+        const QPointF end = branch.currentPosition();
+        const int flowers = flowerCounts[node];
+        const qreal terminalLeafSize = stats.tipLeaf;
+        QRandomGenerator traits(seed ^ (quint32(node + 1) * 0x5bd1e995U));
+        // Geometry consumes the first two trait slots (angle and bend).
+        traits.generateDouble();
+        traits.generateDouble();
+        auto unit = [&] { return traits.generateDouble(); };
+        // A terminal leaf consumes one allocated leaf, rather than being an
+        // extra motif outside the progress budget.
+        const int leaves = leafCounts[index] - (flowers == 0 ? 1 : 0);
+        branchLeafSizes.append(leafCounts[index] == 0 ? 0 : leaves > 0 ? stats.basalLeaf : terminalLeafSize);
+        for (int leaf = 0; leaf < leaves; ++leaf) {
+            const qreal u = 0.28 + 0.64 * leaf / leaves;
+            const QPointF position = branch.pointAtPercent(u);
+            const qreal side = leaf % 2 ? -1 : 1;
+            const qreal enlargement = 1 + qBound(qreal(0), (1 - u) / 0.72, qreal(1));
+            const qreal size = (leafFloor + (5 + 12 * age) * (1 - t) * (1 - 0.55 * u)) * enlargement;
+            garden.organs.append({OrganKind::Leaf, position, degrees(tangent(branch, u)) + side * (30 + unit() * 20), size, 0, index});
+        }
+        QRandomGenerator flowering(seed ^ (quint32(node + 1) * 0x6e7329b5U));
+        flowering.generateDouble();
+        const qreal terminalFlowerSize = flowerRadius * (0.8 + 0.4 * flowering.generateDouble());
+        const qreal terminalSize = flowers == 0 ? terminalLeafSize : terminalFlowerSize;
+        garden.organs.append({flowers == 0 ? OrganKind::Leaf : OrganKind::Flower, end, degrees(endDirection(branch)), terminalSize, 0, index});
+        QRandomGenerator extraFlowers(seed ^ (quint32(node + 1) * 0x85ebca6bU));
+        for (int site = 0; site < flowers - 1; ++site) {
+            extraFlowers.generateDouble();
+            // Use most of the stem for flower centers, rather than packing
+            // all three into its distal half. Moderate silhouette overlap remains.
+            const qreal u = (flowers == 2 ? 0.12 : 0.55 - 0.45 * site) + (extraFlowers.generateDouble() - 0.5) * 0.03;
+            const qreal size = flowerRadius * (0.8 + 0.4 * extraFlowers.generateDouble());
+            garden.organs.append({OrganKind::Flower, branch.pointAtPercent(u), degrees(tangent(branch, u)), size, 0, index});
+        }
+    }
+    // Phase 3: decorate the main axis independently of branch random streams.
+    for (int flower = 0; flower < plan.axisFlowers; ++flower) {
+        // Independent fixed sites keep existing flowers stable as the main
+        // axis gains its second and third flowers.
+        QRandomGenerator axisFlower(seed ^ 0x7ad19b43U ^ (quint32(flower) * 0x9e3779b9U));
+        const qreal fraction = flower == 0 ? 0.22 + 0.18 * axisFlower.generateDouble() : 0.32 + 0.2 * flower + (axisFlower.generateDouble() - 0.5) * 0.08;
+        const qreal t = primary.path.percentAtLength(axisLength * fraction);
+        const qreal size = flowerRadius * (0.8 + 0.4 * axisFlower.generateDouble());
+        garden.organs.append({OrganKind::Flower, primary.path.pointAtPercent(t), degrees(tangent(primary.path, t)), size, 0, 0});
+    }
+    // Spread the allocated leaves across the full axis, then stagger their
+    // positions within each interval. Alternate sides without symmetric pairs.
+    const int axisLeaves = leafCounts[0] - 1;
+    QRandomGenerator foliage(seed ^ 0x43b0d7e5U);
+    const int firstSide = foliage.bounded(2) ? -1 : 1;
+    for (int i = 0; i < axisLeaves; ++i) {
+        QRandomGenerator leafTraits(seed ^ (quint32(i + 1) * 0x27d4eb2dU));
+        const qreal fraction = 0.08 + 0.84 * (i + 0.22 + leafTraits.generateDouble() * 0.56) / axisLeaves;
+        const qreal distance = axisLength * fraction;
+        const qreal t = primary.path.percentAtLength(distance);
+        qreal size = leafFloor;
+        qreal nearest = axisLength;
+        for (int branch = 0; branch < branchDistances.size(); ++branch) {
+            if (branchLeafSizes[branch] > 0 && std::abs(distance - branchDistances[branch]) < nearest) {
+                nearest = std::abs(distance - branchDistances[branch]);
+                size = branchLeafSizes[branch];
+            }
+        }
+        const qreal angle = firstSide * (i % 2 ? -1 : 1) * (28 + leafTraits.generateDouble() * 30);
+        garden.organs.append({OrganKind::Leaf, primary.path.pointAtPercent(t), degrees(tangent(primary.path, t)) + angle, size, 0, 0});
+    }
+    return garden;
+}
+
+}
+#endif
