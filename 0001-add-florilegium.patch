@@ -0,0 +1,515 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "growth.h"
+#include "part/pagedecorationinterface.h"
+#include "species.h"
+
+#include <QCache>
+#include <QPainterPath>
+#include <QPicture>
+#include <QRandomGenerator>
+#include <QtMath>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <memory>
+
+namespace
+{
+constexpr qreal pi = 3.14159265358979323846;
+constexpr int stripWidth = 100;
+constexpr qreal footerFlowerRadiusPixels = 24;
+
+qreal minimumLeafPixels(const Floral::Species &species)
+{
+    return species.leaflets > 1 ? 24 : species.leafShape == Floral::LeafShape::Narrow ? 16 : 12;
+}
+
+QPainterPath leaf(qreal length, qreal width)
+{
+    QPainterPath path;
+    path.cubicTo(width, -length * 0.25, width, -length * 0.7, 0, -length);
+    path.cubicTo(-width, -length * 0.7, -width, -length * 0.25, 0, 0);
+    return path;
+}
+
+// Paint in alpha: the raster cache later tints these washes with the user's ink.
+void wash(QPainter &painter, const QPainterPath &outline, qreal length, qreal width, QRandomGenerator &random, bool veins, Okular::PageDecorationStyle style)
+{
+    painter.save();
+    painter.setClipPath(outline, Qt::IntersectClip);
+    if (style != Okular::PageDecorationStyle::Watercolor) {
+        painter.setPen(style == Okular::PageDecorationStyle::Outline ? QPen(QColor(255, 255, 255, 210), 0.8) : QPen(Qt::NoPen));
+        painter.setBrush(style == Okular::PageDecorationStyle::Silhouette ? QBrush(QColor(255, 255, 255, 190)) : QBrush(Qt::NoBrush));
+        painter.drawPath(outline);
+        if (veins) {
+            painter.setPen(QPen(QColor(255, 255, 255, 150), 0.4));
+            painter.drawLine(QPointF(0, -length * 0.1), QPointF(0, -length * 0.85));
+        }
+        painter.restore();
+        return;
+    }
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(QColor(255, 255, 255, 85));
+    painter.drawPath(outline);
+    for (int i = 0; i < 12; ++i) {
+        const qreal x = (random.generateDouble() * 2 - 1) * width;
+        const qreal y = -random.generateDouble() * length;
+        const qreal radius = length * (0.12 + random.generateDouble() * 0.24);
+        QRadialGradient pigment(QPointF(x, y), radius);
+        pigment.setColorAt(0, QColor(255, 255, 255, 40 + random.bounded(45)));
+        pigment.setColorAt(1, QColor(255, 255, 255, 0));
+        painter.setBrush(pigment);
+        painter.drawEllipse(QPointF(x, y), radius, radius * 0.7);
+    }
+    // A soft pooled edge, with transparent veins lifted out of the pigment.
+    painter.setBrush(Qt::NoBrush);
+    painter.setPen(QPen(QColor(255, 255, 255, 55), 0.7));
+    painter.drawPath(outline);
+    painter.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+    painter.setPen(QPen(QColor(255, 255, 255, 95), 0.45));
+    QPainterPath spine;
+    spine.moveTo(0, -length * 0.08);
+    spine.quadTo(width * 0.08, -length * 0.5, 0, -length * 0.88);
+    painter.drawPath(spine);
+    if (veins) {
+        for (int i = 2; i < 7; ++i) {
+            const qreal y = -length * i / 8;
+            for (int side : {-1, 1}) {
+                QPainterPath vein(QPointF(0, y));
+                vein.quadTo(side * width * 0.4, y - length * 0.06, side * width * 0.65, y - length * 0.14);
+                painter.drawPath(vein);
+            }
+        }
+    }
+    painter.restore();
+}
+
+QPainterPath blade(const Floral::Species &species, qreal length, qreal width)
+{
+    QPainterPath path;
+    path.moveTo(0, 0);
+    // A width envelope defines the species' leaf. Lobes and teeth modulate it;
+    // their amplitude vanishes at the base and tip.
+    auto edge = [&](qreal v) {
+        const qreal envelope = std::pow(std::sin(pi * v), species.leafShape == Floral::LeafShape::Narrow ? 0.8 : 0.65);
+        qreal modulation = species.leafShape == Floral::LeafShape::Lobed ? 0.72 + 0.28 * std::cos(v * 10 * pi) : 1;
+        if (species.toothed) {
+            modulation *= 0.91 + 0.09 * std::cos(v * 28 * pi);
+        }
+        return width * envelope * modulation;
+    };
+    for (int i = 1; i <= 42; ++i) {
+        const qreal v = i / 42.0;
+        path.lineTo(edge(v), -length * v);
+    }
+    for (int i = 41; i >= 0; --i) {
+        const qreal v = i / 42.0;
+        path.lineTo(-edge(v), -length * v);
+    }
+    path.closeSubpath();
+    return path;
+}
+
+void drawBlade(QPainter &painter, const Floral::Species &species, qreal length, QRandomGenerator &pigment, Okular::PageDecorationStyle style)
+{
+    const qreal width = length * species.leafWidth;
+    wash(painter, blade(species, length, width), length, width, pigment, species.veins == Floral::Veins::Pinnate, style);
+    if (species.veins == Floral::Veins::Parallel && style == Okular::PageDecorationStyle::Watercolor) {
+        painter.save();
+        painter.setClipPath(blade(species, length, width), Qt::IntersectClip);
+        painter.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+        painter.setPen(QPen(QColor(255, 255, 255, 90), 0.35));
+        for (int side : {-1, 1}) {
+            QPainterPath vein(QPointF(0, -length * 0.05));
+            vein.cubicTo(side * width * 0.7, -length * 0.3, side * width * 0.7, -length * 0.7, 0, -length * 0.95);
+            painter.drawPath(vein);
+        }
+        painter.restore();
+    }
+}
+
+void drawLeaf(QPainter &painter, const Floral::Species &species, qreal length, QRandomGenerator &pigment, Okular::PageDecorationStyle style)
+{
+    if (species.leaflets == 1) {
+        drawBlade(painter, species, length, pigment, style);
+        return;
+    }
+    painter.save();
+    painter.setPen(QPen(QColor(255, 255, 255, 150), 0.5));
+    painter.drawLine(QPointF(0, 0), QPointF(0, -length * 0.8));
+    const int pairs = (species.leaflets - 1) / 2;
+    for (int i = 0; i < pairs; ++i) {
+        for (int side : {-1, 1}) {
+            painter.save();
+            painter.translate(0, -length * (0.2 + 0.5 * i / pairs));
+            painter.rotate(side * 55);
+            drawBlade(painter, species, length * (0.42 - 0.06 * i), pigment, style);
+            painter.restore();
+        }
+    }
+    painter.translate(0, -length * 0.65);
+    drawBlade(painter, species, length * 0.35, pigment, style);
+    painter.restore();
+}
+
+void drawFlower(QPainter &painter, const Floral::Species &species, qreal radius, QRandomGenerator &pigment, Okular::PageDecorationStyle style)
+{
+    painter.save();
+    if (species.plan == Floral::Plan::Bell) {
+        painter.rotate(180);
+        QPainterPath bell;
+        bell.cubicTo(-radius * 0.2, -radius * 0.1, -radius * 0.25, -radius * 0.7, -radius * 0.55, -radius);
+        for (int i = 0; i < 5; ++i) {
+            const qreal x = -radius * 0.55 + i * radius * 0.22;
+            bell.quadTo(x + radius * 0.11, -radius * 0.8, x + radius * 0.22, -radius);
+        }
+        bell.cubicTo(radius * 0.25, -radius * 0.7, radius * 0.2, -radius * 0.1, 0, 0);
+        wash(painter, bell, radius, radius * 0.55, pigment, false, style);
+    } else {
+        for (int layer = 0; layer < species.layers; ++layer) {
+            const qreal length = radius * (layer == 0 ? 1 : 0.65);
+            const qreal width = length * species.petalWidth;
+            for (int i = 0; i < species.petals; ++i) {
+                painter.save();
+                painter.rotate(i * 360.0 / species.petals + layer * 36 + std::sin(qreal(species.seed % 1024) + i * 1.7 + layer) * 2);
+                wash(painter, leaf(length, width), length, width, pigment, false, style);
+                painter.restore();
+            }
+        }
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(QColor(255, 255, 255, 190));
+        painter.drawEllipse(QPointF(), radius * 0.12, radius * 0.12);
+        if (species.plan == Floral::Plan::Daisy) {
+            for (int i = 0; i < 22; ++i) {
+                const qreal r = radius * 0.24 * std::sqrt(i / 22.0);
+                const qreal angle = i * 2.39996323;
+                painter.drawEllipse(QPointF(r * std::cos(angle), r * std::sin(angle)), radius * 0.035, radius * 0.035);
+            }
+        } else if (species.plan == Floral::Plan::Lily) {
+            painter.setPen(QPen(QColor(255, 255, 255, 200), 0.45));
+            for (int i = 0; i < 6; ++i) {
+                const QPointF tip(radius * 0.28 * std::cos(i * pi / 3), radius * 0.28 * std::sin(i * pi / 3));
+                painter.drawLine(QPointF(), tip);
+                painter.drawEllipse(tip, radius * 0.045, radius * 0.045);
+            }
+        }
+    }
+    painter.restore();
+}
+
+void drawCluster(QPainter &painter, const Floral::Species &species, qreal radius, QRandomGenerator &pigment, Okular::PageDecorationStyle style)
+{
+    if (species.cluster == Floral::Cluster::Single) {
+        drawFlower(painter, species, radius, pigment, style);
+        return;
+    }
+    painter.save();
+    painter.setPen(QPen(QColor(255, 255, 255, 160), 0.55));
+    if (species.cluster == Floral::Cluster::Umbel) {
+        for (int i = 0; i < species.flowers; ++i) {
+            const qreal angle = pi * (0.1 + 0.8 * i / (species.flowers - 1));
+            const QPointF tip(radius * 0.75 * std::cos(angle), -radius * 0.7 * std::sin(angle));
+            painter.drawLine(QPointF(0, radius * 0.35), tip);
+            painter.save();
+            painter.translate(tip);
+            drawFlower(painter, species, radius * (0.16 + 0.08 * (0.5 + 0.5 * std::sin(i * 2.4 + species.seed % 97))), pigment, style);
+            painter.restore();
+        }
+    } else {
+        painter.drawLine(QPointF(0, radius * 0.6), QPointF(0, -radius * 0.65));
+        for (int i = 0; i < species.flowers; ++i) {
+            const qreal y = radius * (0.4 - i * 0.95 / (species.flowers - 1));
+            const QPointF tip((i % 2 ? -1 : 1) * radius * 0.38, y - radius * 0.12);
+            painter.drawLine(QPointF(0, y), tip);
+            painter.save();
+            painter.translate(tip);
+            drawFlower(painter, species, radius * (0.38 - 0.19 * i / (species.flowers - 1)), pigment, style);
+            painter.restore();
+        }
+    }
+    painter.restore();
+}
+
+QPicture *grow(quint32 seed,
+               int density,
+               const Floral::Species &species,
+               Okular::PageDecorationStyle style,
+               qreal height,
+               bool footer,
+               bool overflow,
+               qreal readingProgress,
+               int documentPages,
+               qreal minimumLeafSize,
+               qreal flowerRadius,
+               const Floral::VerticalCommunity *community)
+{
+    Floral::Garden garden = Floral::growGarden(seed, density, species, height, footer, overflow, readingProgress, documentPages, minimumLeafSize, flowerRadius, community);
+    auto *picture = new QPicture;
+    QPainter painter(picture);
+    painter.setRenderHint(QPainter::Antialiasing);
+    QRandomGenerator pigment(seed ^ 0x8a31d5b7U);
+    // Filled tapered strokes preserve the hierarchy from primary shoots to
+    // fine pedicels, instead of drawing every branch with the same pen width.
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(QColor(255, 255, 255, 165));
+    for (const Floral::Stem &stem : garden.stems) {
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(QColor(255, 255, 255, qRound(165 - stem.senescence * 45)));
+        const QRectF bounds = stem.path.boundingRect();
+        const int count = qBound(8, qCeil((bounds.width() + bounds.height()) / 4), 800);
+        QPolygonF left, right;
+        for (int i = 0; i <= count; ++i) {
+            const qreal t = i / qreal(count);
+            const QPointF axis = Floral::tangent(stem.path, t);
+            const QPointF normal(-axis.y(), axis.x());
+            // Keep even juvenile pedicels readable: 0.9 logical pixels at
+            // the page scale, independent of progress and supersampling.
+            const qreal leafPixels = minimumLeafPixels(species);
+            const qreal minimumWidth = footer ? minimumLeafSize / leafPixels * 0.9 : 0;
+            const qreal width = qMax(minimumWidth, stem.baseWidth * (1 - t) + stem.tipWidth * t) / 2;
+            const QPointF point = stem.path.pointAtPercent(t);
+            left.append(point + normal * width);
+            right.append(point - normal * width);
+        }
+        QPainterPath outline;
+        outline.moveTo(left.first());
+        for (int i = 1; i < left.size(); ++i) {
+            outline.lineTo(left[i]);
+        }
+        for (int i = right.size() - 1; i >= 0; --i) {
+            outline.lineTo(right[i]);
+        }
+        outline.closeSubpath();
+        painter.drawPath(outline);
+        if (stem.senescence > 0.2) {
+            painter.setBrush(Qt::NoBrush);
+            painter.setPen(QPen(QColor(255, 255, 255, qRound(stem.senescence * 110)), stem.baseWidth * 0.18, Qt::DashLine, Qt::RoundCap));
+            painter.drawPath(stem.path);
+        }
+    }
+    if (footer) {
+        // Layer foliage first, then buds, then every open flower. Stable order
+        // preserves the composition within a layer even when motifs overlap.
+        std::stable_sort(garden.organs.begin(), garden.organs.end(), [](const Floral::Organ &a, const Floral::Organ &b) {
+            auto layer = [](Floral::OrganKind kind) { return kind == Floral::OrganKind::Leaf ? 0 : kind == Floral::OrganKind::Bud ? 1 : 2; };
+            return layer(a.kind) < layer(b.kind);
+        });
+    }
+    for (const Floral::Organ &organ : garden.organs) {
+        const auto &organSpecies = community && !footer ? (*community)[organ.speciesIndex] : species;
+        painter.save();
+        painter.translate(organ.position);
+        painter.rotate(organ.angle);
+        switch (organ.kind) {
+        case Floral::OrganKind::Leaf:
+            // Curl and narrow older leaves while retaining the configured ink.
+            painter.scale(1 - organ.senescence * 0.6, 1 - organ.senescence * 0.2);
+            painter.setOpacity(1 - organ.senescence * 0.3);
+            drawLeaf(painter, organSpecies, organ.size, pigment, style);
+            break;
+        case Floral::OrganKind::Flower:
+            if (organ.senescence > 0.35) {
+                // A spent flower retains its receptacle and sparse seed stalks.
+                painter.setPen(QPen(QColor(255, 255, 255, 150), 0.45));
+                painter.setBrush(QColor(255, 255, 255, 125));
+                for (int i = 0; i < 7; ++i) {
+                    const qreal angle = i * 2 * pi / 7;
+                    const QPointF tip(std::cos(angle) * organ.size * 0.4, std::sin(angle) * organ.size * 0.4);
+                    painter.drawLine(QPointF(), tip);
+                    painter.drawEllipse(tip, organ.size * 0.055, organ.size * 0.055);
+                }
+                painter.drawEllipse(QPointF(), organ.size * 0.12, organ.size * 0.12);
+            } else {
+                painter.setOpacity(1 - organ.senescence);
+                drawCluster(painter, organSpecies, organ.size, pigment, style);
+            }
+            break;
+        case Floral::OrganKind::Bud:
+            painter.setPen(QPen(QColor(255, 255, 255, 170), 0.45));
+            painter.setBrush(QColor(255, 255, 255, 135));
+            painter.drawEllipse(QRectF(-organ.size * 0.3, -organ.size, organ.size * 0.6, organ.size));
+            break;
+        }
+        painter.restore();
+    }
+    painter.end();
+    return picture;
+}
+}
+
+class FloralPlugin : public QObject, public Okular::PageDecorationInterface
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID OkularPageDecorationInterface_iid)
+    Q_INTERFACES(Okular::PageDecorationInterface)
+
+public:
+    void paint(QPainter *painter, const QRectF &page, quint32 seed, int density, int width, const QColor &color, quint32 bookSeed, Okular::PageDecorationStyle style) override
+    {
+        const auto plants = Floral::community(bookSeed);
+        const Floral::VerticalCommunity vertical {plants[0], plants[1], plants[2]};
+        painter->save();
+        drawStrip(painter, QRectF(page.left() - width - 4, page.top(), width, page.height()), seed, density, color, plants[0], style, false, false, 1, 0, &vertical);
+        painter->restore();
+        painter->save();
+        painter->translate(page.left(), page.bottom() + 4);
+        painter->rotate(90);
+        drawStrip(painter, QRectF(0, -page.width(), width, page.width()), seed ^ 0x723f49abU, density, color, plants[3], style, true);
+        painter->restore();
+        // Both stems meet outside the lower-left corner; the footer grows right.
+        painter->save();
+        QColor stemColor = color;
+        stemColor.setAlphaF(stemColor.alphaF() * 0.61);
+        painter->setPen(QPen(stemColor, qMax(qreal(0.5), width * 0.012), Qt::SolidLine, Qt::RoundCap));
+        const qreal rootX = page.left() - 4 - width * 0.55;
+        const qreal rootY = page.bottom() + 4 + width * 0.45;
+        QPainterPath corner(QPointF(rootX, page.bottom()));
+        corner.cubicTo(rootX, rootY, rootX, rootY, page.left(), rootY);
+        painter->setBrush(Qt::NoBrush);
+        painter->drawPath(corner);
+        painter->restore();
+    }
+
+    void paintWatermark(QPainter *painter, const QRectF &page, quint32 seed, int density, int width, const QColor &color, quint32 bookSeed, Okular::PageDecorationStyle style, qreal readingProgress, int documentPages) override
+    {
+        painter->save();
+        readingProgress = qBound(qreal(0), readingProgress, qreal(1));
+        const auto plants = Floral::community(bookSeed);
+        const Floral::VerticalCommunity vertical {plants[0], plants[1], plants[2]};
+        const qreal left = qMin(qreal(width), page.width() * 0.3);
+        const qreal bottom = qMin(qreal(width), page.height() * 0.3);
+        if (left >= 10) {
+            drawStrip(painter, QRectF(page.left() + 4, page.top() + 4, left, page.height() - 8), seed, density, color, plants[0], style, false, true, readingProgress, documentPages, &vertical);
+        }
+        if (left >= 10 && bottom >= 10 && page.width() > 24 && readingProgress >= 0.1) {
+            const qreal scale = left / stripWidth;
+            const qreal height = qMin(qreal(3200), (page.height() - 8) / scale);
+            if (height >= 32) {
+                // The lateral shares a selected primary's basal origin, below
+                // the page. Its hidden junction need not form a visible elbow.
+                const auto attachment = Floral::footerAttachment(seed, plants[0], height, 0, &vertical);
+                const qreal rootX = page.left() + 4 + attachment.position.x() * scale;
+                const qreal length = (page.right() - 4 - rootX) * readingProgress;
+                const qreal growthHeight = bottom * readingProgress;
+                painter->save();
+                // Generate at the actual growth length. The geometry generator
+                // shrinks organs near the tip instead of slicing through them.
+                painter->translate(rootX, page.bottom() - growthHeight * 0.9);
+                painter->rotate(90);
+                drawStrip(painter, QRectF(0, -length, growthHeight, length), seed ^ 0x723f49abU, density, color, plants[3], style, true, true, readingProgress, documentPages);
+                painter->restore();
+            }
+        }
+        painter->restore();
+    }
+
+private:
+    void drawStrip(QPainter *painter,
+                   const QRectF &target,
+                   quint32 seed,
+                   int density,
+                   const QColor &color,
+                   const Floral::Species &species,
+                   Okular::PageDecorationStyle style,
+                   bool footer = false,
+                   bool overflow = false,
+                   qreal readingProgress = 1,
+                   int documentPages = 0,
+                   const Floral::VerticalCommunity *community = nullptr)
+    {
+        if (target.width() <= 0 || target.height() <= 0 || (footer && target.height() < 4)) {
+            return;
+        }
+        // A repaint of text in the page center must not generate edge artwork.
+        const qreal leafPixels = minimumLeafPixels(species);
+        const qreal flowerPadding = footerFlowerRadiusPixels * 1.2 + 1;
+        const qreal endPadding = qMax(leafPixels * 2, flowerPadding);
+        const qreal extra = overflow ? (footer ? target.width() * 1.4 + qMax(leafPixels * 2.2, flowerPadding) : target.width() * 0.5) : 0;
+        const QRectF reach = footer ? target.adjusted(-extra, -endPadding, 0, endPadding) : target.adjusted(0, 0, extra, 0);
+        if (painter->hasClipping() && !painter->clipRegion().intersects(reach.toAlignedRect())) {
+            return;
+        }
+        density = qBound(0, density, 100);
+        // Grow in the target's aspect ratio instead of stretching a fixed strip.
+        // Bound generation at extreme zoom; keep the root anchored and let the
+        // upper end stop rather than distorting the organs to fill the page.
+        const qreal height = qMin(qreal(3200), target.height() * stripWidth / target.width());
+        const qreal scale = target.width() / stripWidth;
+        // A leaf remains legible even while the early footer is scaled down.
+        const qreal minimumLeafSize = footer ? leafPixels / scale : 0;
+        // Fixed logical-pixel flower radius: undo strip scaling so growth in
+        // length/height does not also enlarge flowers as progress changes.
+        const qreal flowerRadius = footer ? footerFlowerRadiusPixels / scale : 8;
+        const qreal minimumX = footer && overflow ? -(140 + qMax(minimumLeafSize * 2.2, flowerPadding / scale)) : 0;
+        const qreal rasterWidth = stripWidth - minimumX + (overflow && !footer ? 50 : 0);
+        // Keep complete enlarged leaves at both ends of the cached strip.
+        const qreal minimumY = footer ? -endPadding / scale : 0;
+        const qreal rasterHeight = height - 2 * minimumY;
+        const QRectF destination(target.left() + minimumX * scale, target.bottom() - height * scale + minimumY * scale, rasterWidth * scale, rasterHeight * scale);
+        QString key = QString::number(int(style)) + QLatin1Char('/') + QString::number(int(species.plan)) + QLatin1Char('/') + QString::number(species.seed) + QLatin1Char('/') + QString::number(seed) + QLatin1Char('/') +
+            QString::number(density) + QLatin1Char('/') + QString::number(height, 'g', 17) + QLatin1Char('/') + QString::number(footer) + QLatin1Char('/') + QString::number(overflow) + QLatin1Char('/') +
+            QString::number(readingProgress, 'g', 17) + QLatin1Char('/') + QString::number(!footer && documentPages > 10) + QLatin1Char('/') + QString::number(minimumLeafSize, 'g', 17) + QLatin1Char('/') +
+            QString::number(flowerRadius, 'g', 17);
+        // The mixed community affects both geometry and motifs. Include every
+        // species so another book/subset cannot reuse a partial-community cache.
+        if (community && !footer) {
+            key += QStringLiteral("/community");
+            for (const auto &member : *community) {
+                key += QLatin1Char('/') + QString::number(member.seed) + QLatin1Char('/') + QString::number(int(member.plan));
+            }
+        }
+        // Include both display DPI and painter zoom/rotation in the resolution.
+        // Render at twice the physical resolution so fine veins survive the final
+        // resampling. Keep a uniform scale and a bounded per-entry allocation.
+        const QTransform device = painter->deviceTransform();
+        const qreal deviceScale = qMax(std::hypot(device.m11(), device.m12()), std::hypot(device.m21(), device.m22()));
+        const qreal resolutionLimit = qMin(8192.0 / qMax(rasterWidth, rasterHeight), std::sqrt(2.0 * 1024 * 1024 / (rasterWidth * rasterHeight)));
+        const qreal rasterScale = qMin(scale * deviceScale * 2, resolutionLimit);
+        const QRectF supersampledSource(0, 0, rasterWidth * rasterScale, rasterHeight * rasterScale);
+        const QRectF source(0, 0, supersampledSource.width() / 2, supersampledSource.height() / 2);
+        const QSize size(qMax(1, qCeil(supersampledSource.width())), qMax(1, qCeil(supersampledSource.height())));
+        const QString imageKey = key + QLatin1Char('/') + QString::number(rasterScale, 'g', 17) + QLatin1Char('/') + QString::number(color.rgba());
+        QImage *cached = m_images.object(imageKey);
+        if (!cached) {
+            std::unique_ptr<QPicture> uncachedPicture;
+            QPicture *picture = m_cache.object(key);
+            if (!picture) {
+                uncachedPicture.reset(grow(seed, density, species, style, height, footer, overflow, readingProgress, documentPages, minimumLeafSize, flowerRadius, community));
+                picture = uncachedPicture.get();
+                const int cost = qMax(1, int(picture->size() / 1024) + 1);
+                if (cost <= m_cache.maxCost()) {
+                    m_cache.insert(key, uncachedPicture.release(), cost);
+                }
+            }
+            QImage image(size, QImage::Format_ARGB32_Premultiplied);
+            image.fill(Qt::transparent);
+            QPainter buffer(&image);
+            buffer.scale(rasterScale, rasterScale);
+            buffer.translate(-minimumX, -minimumY);
+            buffer.drawPicture(0, 0, *picture);
+            buffer.resetTransform();
+            buffer.setCompositionMode(QPainter::CompositionMode_SourceIn);
+            buffer.fillRect(image.rect(), color);
+            buffer.end();
+            // Cache the final physical resolution, not the temporary 2x render.
+            // This keeps four times as many page strips in the same LRU budget.
+            QImage resolved(QSize(qMax(1, qCeil(source.width())), qMax(1, qCeil(source.height()))), QImage::Format_ARGB32_Premultiplied);
+            resolved.fill(Qt::transparent);
+            QPainter downsample(&resolved);
+            downsample.setRenderHint(QPainter::SmoothPixmapTransform);
+            downsample.drawImage(source, image, supersampledSource);
+            downsample.end();
+            cached = new QImage(std::move(resolved));
+            m_images.insert(imageKey, cached, qMax(1, int(cached->sizeInBytes() / 1024)));
+        }
+        painter->save();
+        painter->setRenderHint(QPainter::SmoothPixmapTransform);
+        painter->drawImage(destination, *cached, source);
+        painter->restore();
+    }
+
+    QCache<QString, QPicture> m_cache {8192};
+    QCache<QString, QImage> m_images {32768};
+};
+
