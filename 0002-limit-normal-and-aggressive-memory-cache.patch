@@ -131,7 +132,8 @@ public:
         , m_docdataMigrationNeeded(false)
         , m_synctex_scanner(nullptr)
     {
+        m_pixmapCacheTimer.start();
         QDomImplementation::setInvalidDataPolicy(QDomImplementation::AcceptInvalidChars);
         calculateMaxTextPages();
     }
 
@@ -142,7 +144,10 @@ public:
     qulonglong calculateMemoryToFree();
     void cleanupPixmapMemory();
     void cleanupPixmapMemory(qulonglong memoryToFree);
+    void cleanupExpiredPixmaps();
     AllocatedPixmap *searchLowestPriorityPixmap(bool unloadableOnly = false, bool thenRemoveIt = false, DocumentObserver *observer = nullptr /* any */);
+    void touchAllocatedPixmap(DocumentObserver *observer, int page);
+    qint64 pixmapCacheTtlMs() const;
     void calculateMaxTextPages();
     qulonglong getTotalMemory();
     qulonglong getFreeMemory(qulonglong *freeSwap = nullptr);
@@ -284,6 +289,7 @@ public:
     QMutex m_pixmapRequestsMutex;
     std::list<AllocatedPixmap *> m_allocatedPixmaps;
     qulonglong m_allocatedPixmapsTotalMemory;
+    QElapsedTimer m_pixmapCacheTimer;
     QList<int> m_allocatedTextPagesFifo;
     int m_maxAllocatedTextPages;
     bool m_warnedOutOfMemory;
diff --git a/core/page.cpp b/core/page.cpp
index 27158c6f8..8f620af76 100644
--- a/core/page.cpp
+++ b/core/page.cpp
@@ -225,7 +225,11 @@ bool Page::hasPixmap(DocumentObserver *observer, int width, int height, const No
             return false;
         }
 
-        return tm->hasPixmap(rect);
+        const bool hasPixmap = tm->hasPixmap(rect);
+        if (hasPixmap) {
+            d->m_doc->touchAllocatedPixmap(observer, number());
+        }
+        return hasPixmap;
     }
 
     QMap<DocumentObserver *, PagePrivate::PixmapObject>::const_iterator it = d->m_pixmaps.constFind(observer);
@@ -234,6 +238,7 @@ bool Page::hasPixmap(DocumentObserver *observer, int width, int height, const No
     }
 
     if (width == -1 || height == -1) {
+        d->m_doc->touchAllocatedPixmap(observer, number());
         return true;
     }
 
@@ -261,7 +266,12 @@ bool Page::hasPixmap(DocumentObserver *observer, int width, height, const No
 
     const QPixmap *pixmap = it.value().m_pixmap;
 
-    return (pixmap->width() == width && pixmap->height() == height);
+    const bool hasPixmap = pixmap->width() == width && pixmap->height() == height;
+    if (hasPixmap) {
+        d->m_doc->touchAllocatedPixmap(observer, number());
+    }
+
+    return hasPixmap;
 }
 
 void Page::setPageSize(DocumentObserver *observer, int width, int height)
