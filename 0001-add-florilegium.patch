+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "dlgfloral.h"
+
+#include <KColorButton>
+#include <KLocalizedString>
+#include <QCheckBox>
+#include <QComboBox>
+#include <QFormLayout>
+#include <QHBoxLayout>
+#include <QPushButton>
+#include <QSpinBox>
+#include <limits>
+
+DlgFloral::DlgFloral(QWidget *parent)
+    : QWidget(parent)
+{
+    auto *layout = new QFormLayout(this);
+    auto *floral = new QCheckBox(i18nc("@option:check", "Show plant watermarks on pages"), this);
+    floral->setObjectName(QStringLiteral("kcfg_FloralBorders"));
+    floral->setToolTip(i18nc("@info:tooltip", "Paints pale Delft-blue plants over page content, growing from the lower-left corner."));
+    layout->addRow(QString(), floral);
+    auto *style = new QComboBox(this);
+    style->setObjectName(QStringLiteral("kcfg_FloralStyle"));
+    style->addItems({i18nc("@item:inlistbox plant style", "Watercolor"), i18nc("@item:inlistbox plant style", "Ink outlines"), i18nc("@item:inlistbox plant style", "Silhouette")});
+    style->setEnabled(false);
+    connect(floral, &QCheckBox::toggled, style, &QWidget::setEnabled);
+    layout->addRow(i18nc("@label:listbox", "Plant style:"), style);
+    auto *variation = new QSpinBox(this);
+    variation->setObjectName(QStringLiteral("kcfg_FloralVariation"));
+    variation->setRange(0, std::numeric_limits<int>::max());
+    variation->setToolTip(i18nc("@info:tooltip", "The same variation restores the same plants. This setting applies to all books."));
+    auto *regenerate = new QPushButton(i18nc("@action:button", "New plants"), this);
+    regenerate->setObjectName(QStringLiteral("floral_regenerate"));
+    connect(regenerate, &QPushButton::clicked, this, [variation] { variation->setValue(variation->value() == variation->maximum() ? 0 : variation->value() + 1); });
+    variation->setEnabled(false);
+    regenerate->setEnabled(false);
+    connect(floral, &QCheckBox::toggled, variation, &QWidget::setEnabled);
+    connect(floral, &QCheckBox::toggled, regenerate, &QWidget::setEnabled);
+    auto *variationLayout = new QHBoxLayout;
+    variationLayout->addWidget(variation);
+    variationLayout->addWidget(regenerate);
+    layout->addRow(i18nc("@label:spinbox", "Plant variation:"), variationLayout);
+    auto addFloralSpin = [&](const char *name, const QString &label, int minimum, int maximum, const QString &suffix) {
+        auto *spin = new QSpinBox(this);
+        spin->setObjectName(QString::fromLatin1(name));
+        spin->setRange(minimum, maximum);
+        spin->setSuffix(suffix);
+        spin->setEnabled(false);
+        connect(floral, &QCheckBox::toggled, spin, &QWidget::setEnabled);
+        layout->addRow(label, spin);
+    };
+    addFloralSpin("kcfg_FloralDensity", i18nc("@label:spinbox", "Plant density:"), 0, 100, QStringLiteral(" %"));
+    addFloralSpin("kcfg_FloralOpacity", i18nc("@label:spinbox", "Watermark opacity:"), 5, 100, QStringLiteral(" %"));
+    addFloralSpin("kcfg_FloralWidth", i18nc("@label:spinbox", "Watermark width:"), 16, 160, i18nc("@item:intext pixel unit", " px"));
+    auto *floralColor = new KColorButton(this);
+    floralColor->setObjectName(QStringLiteral("kcfg_FloralColor"));
+    floralColor->setEnabled(false);
+    connect(floral, &QCheckBox::toggled, floralColor, &QWidget::setEnabled);
+    layout->addRow(i18nc("@label:chooser", "Watermark color:"), floralColor);
+}
