diff --git a/part/pagedecorationgeometry.h b/part/pagedecorationgeometry.h
new file mode 100644
index 000000000..850121fb5
--- /dev/null
+++ b/part/pagedecorationgeometry.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_PAGEDECORATIONGEOMETRY_H
+#define OKULAR_PAGEDECORATIONGEOMETRY_H
+
+#include <QList>
+#include <QRectF>
+#include <QRegion>
+
+namespace Okular
+{
+// Content and form rectangles are upright normalized coordinates; annotations
+// already supply their displayed coordinates. Keep rounding outwards for safety.
+inline QRectF decorationPageRect(QRectF normalized, const QRectF &page, int rotation = 0)
+{
+    for (int i = 0; i < rotation % 4; ++i) {
+        normalized = QRectF(1 - normalized.bottom(), normalized.left(), normalized.height(), normalized.width());
+    }
+    return QRectF(page.left() + normalized.left() * page.width(), page.top() + normalized.top() * page.height(), normalized.width() * page.width(), normalized.height() * page.height());
+}
+
+inline QRegion decorationWatermarkClip(const QRectF &visiblePage, const QList<QRectF> &obstacles, qreal padding)
+{
+    QRegion clip(visiblePage.toAlignedRect());
+    for (const QRectF &obstacle : obstacles) {
+        clip -= obstacle.adjusted(-padding, -padding, padding, padding).toAlignedRect();
+    }
+    return clip;
+}
+}
+
+#endif
diff --git a/part/pagedecorationinterface.h b/part/pagedecorationinterface.h
new file mode 100644
