+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_FLORAL_SPECIES_H
+#define OKULAR_FLORAL_SPECIES_H
+
+#include <QRandomGenerator>
+#include <array>
+#include <utility>
+
+namespace Floral
+{
+inline constexpr int bookSpeciesCount = 8;
+inline constexpr int pageSpeciesCount = 4;
+
+enum class Plan { Rose, Daisy, Lily, Bell, Umbel, Mustard };
+enum class Arrangement { Alternate, Opposite, Whorled };
+enum class LeafShape { Oval, Narrow, Lobed };
+enum class Veins { Pinnate, Parallel };
+enum class Cluster { Single, Raceme, Umbel };
+
+struct Species {
+    quint32 seed;
+    Plan plan;
+    int petals;
+    int layers;
+    qreal petalWidth;
+    LeafShape leafShape;
+    qreal leafWidth;
+    bool toothed;
+    Arrangement arrangement;
+    Veins veins;
+    int leaflets;
+    Cluster cluster;
+    int flowers;
+    qreal leafAngle;
+    qreal nodeGap;
+    qreal stemSway;
+    qreal flowerWeight;
+
+    bool operator==(const Species &) const = default;
+};
+
+using VerticalCommunity = std::array<Species, pageSpeciesCount - 1>;
+
+// A small private genome, deliberately independent of Florilegium's 62 traits.
+// Each book has six body plans plus two additional independently seeded species.
+// Multiple species may share a body plan. The constraints belong to the plan,
+// so random choices cannot give a lily serrated leaves or a mustard five petals.
+inline std::array<Species, bookSpeciesCount> speciesPool(quint32 bookSeed)
+{
+    QRandomGenerator random(bookSeed ^ 0x17c8a9e3U);
+    std::array<Species, bookSpeciesCount> pool;
+    for (int i = 0; i < int(pool.size()); ++i) {
+        Species sp {};
+        sp.seed = random.generate();
+        QRandomGenerator traits(sp.seed);
+        sp.plan = i < 6 ? Plan(i) : Plan(traits.bounded(6));
+        sp.petals = 5;
+        sp.layers = 1;
+        sp.petalWidth = 0.35 + traits.generateDouble() * 0.15;
+        sp.leafShape = LeafShape::Oval;
+        sp.leafWidth = 0.24 + traits.generateDouble() * 0.12;
+        sp.toothed = traits.bounded(2);
+        sp.arrangement = Arrangement::Alternate;
+        sp.veins = Veins::Pinnate;
+        sp.leaflets = 1;
+        sp.cluster = Cluster::Single;
+        sp.flowers = 1;
+        sp.leafAngle = 35 + traits.generateDouble() * 25;
+        sp.nodeGap = 32 + traits.generateDouble() * 18;
+        sp.stemSway = 7 + traits.generateDouble() * 10;
+        sp.flowerWeight = 0.4 + traits.generateDouble() * 0.25;
+        switch (sp.plan) {
+        case Plan::Rose:
+            sp.layers = 1 + traits.bounded(2);
+            sp.leaflets = traits.bounded(2) ? 5 : 3;
+            sp.toothed = true;
+            break;
+        case Plan::Daisy:
+            sp.petals = 12 + traits.bounded(11);
+            sp.petalWidth = 0.13 + traits.generateDouble() * 0.08;
+            sp.leafShape = LeafShape::Lobed;
+            break;
+        case Plan::Lily:
+            sp.petals = 6;
+            sp.petalWidth = 0.2 + traits.generateDouble() * 0.12;
+            sp.leafShape = LeafShape::Narrow;
+            sp.leafWidth = 0.1 + traits.generateDouble() * 0.07;
+            sp.veins = Veins::Parallel;
+            sp.toothed = false;
+            sp.arrangement = traits.bounded(2) ? Arrangement::Whorled : Arrangement::Alternate;
+            break;
+        case Plan::Bell:
+            sp.cluster = Cluster::Raceme;
+            sp.flowers = 3 + traits.bounded(3);
+            sp.arrangement = traits.bounded(2) ? Arrangement::Opposite : Arrangement::Alternate;
+            break;
+        case Plan::Umbel:
+            sp.cluster = Cluster::Umbel;
+            sp.flowers = 5 + traits.bounded(4);
+            sp.leaflets = traits.bounded(2) ? 5 : 7;
+            sp.leafShape = LeafShape::Narrow;
+            break;
+        case Plan::Mustard:
+            sp.petals = 4;
+            sp.cluster = Cluster::Raceme;
+            sp.flowers = 3 + traits.bounded(3);
+            sp.leafShape = LeafShape::Lobed;
+            break;
+        }
+        pool[i] = sp;
+    }
+    return pool;
+}
+
+// Select the document's four species once from the book seed. Page seeds
+// affect growth geometry only; species identity and layout roles stay fixed.
+inline std::array<Species, pageSpeciesCount> community(quint32 bookSeed)
+{
+    const auto pool = speciesPool(bookSeed);
+    std::array<int, bookSpeciesCount> order {0, 1, 2, 3, 4, 5, 6, 7};
+    QRandomGenerator random(bookSeed ^ 0x96cb37e1U);
+    for (int i = int(order.size()) - 1; i > 0; --i) {
+        std::swap(order[i], order[random.bounded(i + 1)]);
+    }
+    return {pool[order[0]], pool[order[1]], pool[order[2]], pool[order[3]]};
+}
+}
+
+#endif
