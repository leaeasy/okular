--- /dev/null
+++ b/part/pagedecorationinterface.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OKULAR_PAGEDECORATIONINTERFACE_H
+#define OKULAR_PAGEDECORATIONINTERFACE_H
+
+#include <QColor>
+#include <QPainter>
+#include <QtPlugin>
+
+namespace Okular
+{
+enum class PageDecorationStyle { Watercolor, Outline, Silhouette };
+
+// Private, versioned desktop extension. Coordinates are in logical viewport pixels.
+// The caller supplies a safe clip; plugins must not change the document or painter state.
+// seed controls page composition; bookSeed controls recurring species independently.
+class PageDecorationInterface
+{
+public:
+    virtual ~PageDecorationInterface() = default;
+    virtual void paint(QPainter *painter, const QRectF &page, quint32 seed, int density, int width, const QColor &color, quint32 bookSeed = 0, PageDecorationStyle style = PageDecorationStyle::Watercolor) = 0;
+    virtual void paintWatermark(QPainter *painter, const QRectF &page, quint32 seed, int density, int width, const QColor &color, quint32 bookSeed = 0, PageDecorationStyle style = PageDecorationStyle::Watercolor, qreal readingProgress = 1, int documentPages = 0) = 0;
+};
+}
+
+#define OkularPageDecorationInterface_iid "org.kde.okular.PageDecorationInterface/7.0"
+Q_DECLARE_INTERFACE(Okular::PageDecorationInterface, OkularPageDecorationInterface_iid)
+
+#endif
