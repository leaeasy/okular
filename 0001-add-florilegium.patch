@@ -3643,6 +3666,110 @@ void PageView::drawDocumentOnPainter(const QRect contentsRect, QPainter *p)
         p->fillRect(backRect, backColor);
     }
 
+    if (decorations && Okular::Settings::floralBorders()) {
+        // Keep the loader alive for the lifetime of its plugin. A missing optional
+        // plugin leaves the normal background intact.
+        static QPluginLoader loader;
+        static Okular::PageDecorationInterface *plugin = [&]() -> Okular::PageDecorationInterface * {
+            for (const QString &path : QCoreApplication::libraryPaths()) {
+                const QDir directory(path + QStringLiteral("/okular6/decorations"));
+                for (const QString &file : directory.entryList(QDir::Files)) {
+                    if (QFileInfo(file).completeBaseName() != QLatin1String("libokular_floral") && QFileInfo(file).completeBaseName() != QLatin1String("okular_floral")) {
+                        continue;
+                    }
+                    loader.setFileName(directory.filePath(file));
+                    if (auto *instance = qobject_cast<Okular::PageDecorationInterface *>(loader.instance())) {
+                        return instance;
+                    }
+                    loader.unload();
+                }
+            }
+            return nullptr;
+        }();
+        if (plugin) {
+            const QRegion originalClip = p->hasClipping() ? p->clipRegion() : QRegion(contentsRect);
+            p->save();
+            QColor paper = Qt::white;
+            if (Okular::SettingsCore::changeColors()) {
+                switch (Okular::SettingsCore::renderMode()) {
+                case Okular::SettingsCore::EnumRenderMode::Inverted:
+                case Okular::SettingsCore::EnumRenderMode::InvertLightness:
+                case Okular::SettingsCore::EnumRenderMode::InvertLuma:
+                case Okular::SettingsCore::EnumRenderMode::InvertLumaSymmetric:
+                    paper = Qt::black;
+                    break;
+                case Okular::SettingsCore::EnumRenderMode::Paper:
+                    paper = Okular::SettingsCore::paperColor();
+                    break;
+                case Okular::SettingsCore::EnumRenderMode::Recolor:
+                    paper = Okular::Settings::recolorBackground();
+                    break;
+                default:
+                    break;
+                }
+            }
+            p->setCompositionMode(paper.lightnessF() < 0.5 ? QPainter::CompositionMode_Screen : QPainter::CompositionMode_Multiply);
+            p->setOpacity(Okular::Settings::floralOpacity() / 100.0);
+            const QByteArray identity = QCryptographicHash::hash(d->document->currentDocument().toEncoded(), QCryptographicHash::Sha256);
+            quint32 bookSeed = 0;
+            for (int i = 0; i < 4; ++i) {
+                bookSeed = (bookSeed << 8) | quint8(identity[i]);
+            }
+            // Zero preserves the original document-derived garden. A saved variation
+            // changes both the species pool and the layout, consistently on reopening.
+            bookSeed ^= quint32(Okular::Settings::floralVariation()) * 0x9e3779b9U;
+            // Watermarks have a five-page working window, independent of how
+            // many pages a zoomed-out or multi-column viewport displays.
+            const int currentPage = qMax(0, d->document->viewport().pageNumber);
+            const int firstPage = qMax(0, currentPage - 2);
+            const int lastPage = qMin(int(d->items.size()) - 1, currentPage + 2);
+            for (int pageNumber = firstPage; pageNumber <= lastPage; ++pageNumber) {
+                const PageViewItem *item = d->items[pageNumber];
+                const QRect page = item->croppedGeometry();
+                const int width = Okular::Settings::floralWidth();
+                if (item->isVisible() && page.intersects(contentsRect)) {
+                    const quint32 seed = bookSeed ^ (quint32(item->pageNumber() + 1) * 7919U);
+                    {
+                        const Okular::Page *source = item->page();
+                        const QRectF fullPage = item->uncroppedGeometry();
+                        QList<QRectF> obstacles;
+                        for (const Okular::Annotation *annotation : source->annotations()) {
+                            QRectF rectangle = Okular::decorationPageRect(annotation->transformedBoundingRectangle().geometryF(1, 1), fullPage);
+                            // Popup and stamp icons may extend beyond their normalized bounds.
+                            obstacles.append(rectangle.adjusted(-24, -24, 24, 24));
+                        }
+                        for (const Okular::FormField *field : source->formFields()) {
+                            const QRectF bounds = field->rect().geometryF(1, 1);
+                            obstacles.append(Okular::decorationPageRect(bounds, fullPage, source->rotation()));
+                            // Some backends/widgets retain unrotated form coordinates.
+                            obstacles.append(Okular::decorationPageRect(bounds, fullPage));
+                        }
+                        const qreal padding = qMax(6.0, item->zoomFactor() * 3.0);
+                        const QRegion safe = Okular::decorationWatermarkClip(page, obstacles, padding) & QRegion(contentsRect) & originalClip;
+                        if (!safe.isEmpty()) {
+                            p->save();
+                            // Overlay page content, including documents without known content bounds.
+                            p->setClipRegion(safe);
+                            p->setOpacity(Okular::Settings::floralOpacity() / 100.0);
+                            plugin->paintWatermark(p,
+                                                 page,
+                                                 seed,
+                                                 Okular::Settings::floralDensity(),
+                                                 width,
+                                                 Okular::Settings::floralColor(),
+                                                 bookSeed,
+                                                 static_cast<Okular::PageDecorationStyle>(Okular::Settings::floralStyle()),
+                                                 qreal(item->pageNumber() + 1) / qMax(1U, d->document->pages()),
+                                                 d->document->pages());
+                            p->restore();
+                        }
+                    }
+                }
+            }
+            p->restore();
+        }
+    }
